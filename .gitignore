# --- Modèles lourds (NE PAS versionner les binaires) ---
*.gguf
*.bin
*.safetensors
*.zip
*.tar.gz
*.7z

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
build/
venv/
.venv/
*.egg-info/

# --- Système / IDE ---
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# --- Logs & données locales ---
*.log
logs/
data/
tributes.json
